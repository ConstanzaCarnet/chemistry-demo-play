{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quimica-quest/mundo.schema.json",
  "title": "Mundo",
  "description": "Unidad temática con cards de teoría y ejercicios.",
  "type": "object",
  "required": ["id", "num", "icon", "color", "titulo", "sub", "cards", "ejercicios"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "num": { "type": "integer", "minimum": 1 },
    "icon": { "type": "string" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "titulo": { "type": "string" },
    "sub": { "type": "string" },
    "fuente": { "type": "string", "description": "Origen del contenido (unidad, página del libro)" },
    "practica": { "type": "array", "items": { "enum": ["masaMolar", "gramosAMoles", "molesAGramos", "molesAParticulas", "molesAVolumen", "estequiometriaMasa", "limitanteGen", "rendimientoGen", "molaridadGen", "composicionGen", "oxGen", "balanceGen", "tipoGen", "phGen"] } },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } },
    "ejercicios": { "type": "array", "minItems": 1, "items": { "$ref": "ejercicio.schema.json" } }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": ["title"],
      "anyOf": [{ "required": ["body"] }, { "required": ["html"] }, { "required": ["list"] }, { "required": ["steps"] }],
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "html": { "type": "string", "description": "HTML de AUTOR (confiable). Nunca contenido del usuario." },
        "list": { "type": "array", "items": { "type": "string" } },
        "example": { "type": "object", "required": ["title", "lines"], "properties": { "title": { "type": "string" }, "lines": { "type": "array", "items": { "type": "string" } } } },
        "steps": { "type": "object", "required": ["title", "items"], "properties": { "title": { "type": "string" }, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
        "tip": { "type": "string" },
        "fact": { "type": "string" }
      }
    }
  }
}
